&CONTROL
  calculation = 'vc-relax'
  prefix = 'pw'
  pseudo_dir = '~/sac_dft/pseudo_gbrv'
  tprnfor = .true.
  forc_conv_thr = 1.0d-3
  etot_conv_thr = 1.0d-4
  nstep = 200
  max_seconds = 20400
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 40
  ecutrho = 200
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  vdw_corr = 'dft-d3'
  dftd3_version = 4
  nspin = 2
  starting_magnetization(1) = 0.050
/
&ELECTRONS
  conv_thr = 1.0d-7
  mixing_beta = 0.1
  mixing_ndim = 16
  scf_must_converge = .false.
  mixing_mode = 'local-TF'
  electron_maxstep = 600
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press_conv_thr = 0.5
/

ATOMIC_SPECIES
  Zn    65.380  zn_pbe_v1.uspp.F.UPF

CELL_PARAMETERS angstrom
      2.66000000     0.00000000     0.00000000
     -1.33000000     2.30362757     0.00000000
      0.00000000     0.00000000     4.95000000

ATOMIC_POSITIONS angstrom
  Zn      0.00000000     0.00000000     0.00000000
  Zn      0.00000000     1.53575172     2.47500000

K_POINTS automatic
  16 16 10 0 0 0
