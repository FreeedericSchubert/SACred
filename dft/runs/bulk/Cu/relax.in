&CONTROL
  calculation = 'vc-relax'
  prefix = 'pw'
  pseudo_dir = '~/sac_dft/pseudo_gbrv'
  tprnfor = .true.
  forc_conv_thr = 1.0d-3
  etot_conv_thr = 1.0d-4
  nstep = 200
  max_seconds = 20400
/
&SYSTEM
  ibrav = 0
  nat = 1
  ntyp = 1
  ecutwfc = 40
  ecutrho = 200
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  vdw_corr = 'dft-d3'
  dftd3_version = 4
  nspin = 2
  starting_magnetization(1) = 0.053
/
&ELECTRONS
  conv_thr = 1.0d-7
  mixing_beta = 0.1
  mixing_ndim = 16
  scf_must_converge = .false.
  mixing_mode = 'local-TF'
  electron_maxstep = 600
/
&IONS
  ion_dynamics = 'bfgs'
/
&CELL
  cell_dynamics = 'bfgs'
  press_conv_thr = 0.5
/

ATOMIC_SPECIES
  Cu    63.546  cu_pbe_v1.2.uspp.F.UPF

CELL_PARAMETERS angstrom
      0.00000000     1.81500000     1.81500000
      1.81500000     0.00000000     1.81500000
      1.81500000     1.81500000     0.00000000

ATOMIC_POSITIONS angstrom
  Cu      0.00000000     0.00000000     0.00000000

K_POINTS automatic
  16 16 16 0 0 0
