&CONTROL
  calculation = 'relax'
  prefix = 'pw'
  pseudo_dir = '~/sac_dft/pseudo_gbrv'
  tprnfor = .true.
  forc_conv_thr = 1.0d-3
  etot_conv_thr = 1.0d-4
  nstep = 200
  max_seconds = 20400
  tefield = .true.
  dipfield = .true.
/
&SYSTEM
  ibrav = 0
  nat = 3
  ntyp = 2
  ecutwfc = 40
  ecutrho = 200
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  vdw_corr = 'dft-d3'
  dftd3_version = 4
  nosym = .true.
  edir = 3
  emaxpos = 0.85
  eopreg = 0.05
  eamp = 0.0
/
&ELECTRONS
  conv_thr = 1.0d-7
  mixing_beta = 0.1
  mixing_ndim = 16
  scf_must_converge = .false.
  mixing_mode = 'local-TF'
  electron_maxstep = 600
/
&IONS
  ion_dynamics = 'bfgs'
/

ATOMIC_SPECIES
  O     15.999  o_pbe_v1.2.uspp.F.UPF
  H      1.008  h_pbe_v1.4.uspp.F.UPF

CELL_PARAMETERS angstrom
     14.80199988     0.00000000     0.00000000
      7.40099994    12.81890194     0.00000000
      0.00000000     0.00000000    20.00000337

ATOMIC_POSITIONS angstrom
  O      11.10149991     6.40945097     8.40000169
  H      11.86149991     6.40945097     8.99000169
  H      10.34149991     6.40945097     8.99000169

K_POINTS gamma
